# Copy to .env (git-ignored) and adjust. Real environment variables win over this file.
# DB_USER=routewise_app
# DB_PASSWORD=change-me            # or run: scripts/set_app_password.sh 'a-long-new-password'
# DB_HOST=localhost
# DB_NAME=public_transport
# SECRET_KEY=a-long-random-string  # keeps logins valid across restarts
# DEMO_USERS=0                     # do not create the demo accounts (create an admin with scripts/create_admin.py)
# REPORT_CACHE_SECONDS=30          # 0 switches the report cache off
# METRICS_TOKEN=a-long-random-string  # switches on /metrics (Prometheus: Authorization: Bearer <token>)
# --- docker compose (see docker-compose.yml) ---
# MYSQL_ROOT_PASSWORD=change-me-root
# APP_DB_PASSWORD=change-me-app
# SITE_ADDRESS=localhost             # or your domain name for a real certificate
